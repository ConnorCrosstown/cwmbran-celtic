# Cwmbran Celtic AFC - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# AUTHENTICATION (NextAuth.js)
# ===========================================

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ===========================================
# COMET API KEYS (Welsh FA Data Platform)
# Contact FAW for API access: https://kb.analyticom.de/comet/api-access-to-comet-data
# ===========================================

# Fixtures data
COMET_API_KEY_FIXTURES=

# Results data
COMET_API_KEY_RESULTS=

# Men's league table
COMET_API_KEY_LEAGUE=

# Ladies league table
COMET_API_KEY_LADIES_LEAGUE=

# Squad data
COMET_API_KEY_SQUAD=

# Player statistics
COMET_API_KEY_STATS=

# ===========================================
# SITE CONFIGURATION
# ===========================================

# Base URL for the site (used in sitemap, meta tags, etc.)
# Defaults to https://cwmbran-celtic.vercel.app if unset (the canonical
# `cwmbranceltic.com` host currently 403s — see AUDIT-2026-05-20.md P0-1).
NEXT_PUBLIC_SITE_URL=https://cwmbran-celtic.vercel.app

# ===========================================
# OPTIONAL: ANALYTICS
# ===========================================

# Google Analytics ID (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# NEWSLETTER (Resend)
# ===========================================

# Resend API key - get from https://resend.com/api-keys
RESEND_API_KEY=

# Staff secret for sending newsletters (generate a random string).
# IMPORTANT: do NOT prefix this with NEXT_PUBLIC_ — that would leak it into
# the browser bundle (see AUDIT-2026-05-20.md P0-5). The admin newsletter
# UI must call /api/newsletter/send via session-authenticated proxy.
NEWSLETTER_STAFF_SECRET=

# ===========================================
# OPTIONAL: EMAIL SERVICE
# ===========================================

# Email service API key (for form submissions)
# EMAIL_SERVICE_API_KEY=

# Contact form recipient email
# CONTACT_EMAIL=info@cwmbranceltic.com

# ===========================================
# SOFASCORE / APIFY INTEGRATION
# ===========================================

# Apify API token for SofaScore scraping
# Get from https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Webhook secret for Apify to push data automatically
# Generate with: openssl rand -hex 32
# Add this to your Apify Actor's webhook URL as ?secret=YOUR_SECRET
APIFY_WEBHOOK_SECRET=

# Admin secret for manual SofaScore data refresh API
# Generate with: openssl rand -base64 32
# If not set, AUTH_SECRET is used
SOFASCORE_ADMIN_SECRET=
